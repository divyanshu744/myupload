{
 "duration": 112.798,
 "voice": "hm_omega",
 "speed": 1.15,
 "lines": [
  {
   "i": 0,
   "text": "\u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902, \u0915\u093f \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0915\u093e \u0915\u0902\u0920 \u0928\u0940\u0932\u093e \u0915\u094d\u092f\u094b\u0902 \u0939\u0948?",
   "start": 0.3,
   "end": 3.868
  },
  {
   "i": 1,
   "text": "\u0928\u0939\u0940\u0902? \u0924\u094b \u0906\u0907\u090f, \u092e\u0948\u0902 \u092c\u0924\u093e\u0924\u093e \u0939\u0942\u0901\u0964",
   "start": 4.118,
   "end": 5.943
  },
  {
   "i": 2,
   "text": "\u090f\u0915 \u0938\u092e\u092f \u0915\u0940 \u092c\u093e\u0924 \u0939\u0948, \u0926\u0947\u0935\u0930\u093e\u091c \u0907\u0902\u0926\u094d\u0930 \u0905\u092a\u0928\u0947 \u0939\u093e\u0925\u0940 \u0910\u0930\u093e\u0935\u0924 \u092a\u0930 \u0938\u0935\u093e\u0930 \u0925\u0947,",
   "start": 6.243,
   "end": 10.653
  },
  {
   "i": 3,
   "text": "\u0924\u092d\u0940 \u090b\u0937\u093f \u0926\u0941\u0930\u094d\u0935\u093e\u0938\u093e \u0928\u0947 \u0909\u0928\u094d\u0939\u0947\u0902 \u092b\u0942\u0932\u094b\u0902 \u0915\u0940 \u090f\u0915 \u0926\u093f\u0935\u094d\u092f \u092e\u093e\u0932\u093e \u092d\u0947\u0902\u091f \u0915\u0940\u0964",
   "start": 11.033,
   "end": 14.881
  },
  {
   "i": 4,
   "text": "\u0907\u0902\u0926\u094d\u0930 \u0928\u0947 \u0935\u094b \u092e\u093e\u0932\u093e \u0910\u0930\u093e\u0935\u0924 \u0915\u0947 \u0938\u093f\u0930 \u092a\u0930 \u0930\u0916 \u0926\u0940,",
   "start": 15.131,
   "end": 17.881
  },
  {
   "i": 5,
   "text": "\u0914\u0930 \u0910\u0930\u093e\u0935\u0924 \u0928\u0947 \u0909\u0938\u0947 \u091c\u093c\u092e\u0940\u0928 \u092a\u0930 \u092b\u0947\u0902\u0915\u0915\u0930 \u0915\u0941\u091a\u0932 \u0926\u093f\u092f\u093e\u0964",
   "start": 18.271,
   "end": 21.525
  },
  {
   "i": 6,
   "text": "\u0915\u094d\u0930\u094b\u0927\u093f\u0924 \u0926\u0941\u0930\u094d\u0935\u093e\u0938\u093e \u0928\u0947 \u0936\u094d\u0930\u093e\u092a \u0926\u093f\u092f\u093e,",
   "start": 21.775,
   "end": 23.515
  },
  {
   "i": 7,
   "text": "\u0915\u093f \u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0915\u093e \u0938\u093e\u0930\u093e \u0924\u0947\u091c \u0914\u0930 \u0935\u0948\u092d\u0935 \u091a\u0932\u093e \u091c\u093e\u090f\u0917\u093e\u0964",
   "start": 23.855,
   "end": 26.84
  },
  {
   "i": 8,
   "text": "\u0914\u0930 \u0910\u0938\u093e \u0939\u0940 \u0939\u0941\u0906\u0964 \u0905\u0938\u0941\u0930\u094b\u0902 \u0928\u0947 \u0938\u094d\u0935\u0930\u094d\u0917 \u091c\u0940\u0924 \u0932\u093f\u092f\u093e\u0964",
   "start": 27.09,
   "end": 29.793
  },
  {
   "i": 9,
   "text": "\u0939\u093e\u0930\u0947 \u0939\u0941\u090f \u0926\u0947\u0935\u0924\u093e, \u092d\u0917\u0935\u093e\u0928 \u0935\u093f\u0937\u094d\u0923\u0941 \u0915\u0940 \u0936\u0930\u0923 \u092e\u0947\u0902 \u092a\u0939\u0941\u0901\u091a\u0947\u0964",
   "start": 30.043,
   "end": 33.443
  },
  {
   "i": 10,
   "text": "\u0935\u093f\u0937\u094d\u0923\u0941 \u091c\u0940 \u092c\u094b\u0932\u0947, \u0915\u094d\u0937\u0940\u0930\u0938\u093e\u0917\u0930 \u0915\u093e \u092e\u0902\u0925\u0928 \u0915\u0930\u094b,",
   "start": 33.693,
   "end": 36.453
  },
  {
   "i": 11,
   "text": "\u0909\u0938\u092e\u0947\u0902 \u0938\u0947 \u0905\u092e\u0943\u0924 \u0928\u093f\u0915\u0932\u0947\u0917\u093e, \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0905\u092e\u0930 \u0915\u0930 \u0926\u0947\u0917\u093e\u0964",
   "start": 36.793,
   "end": 39.878
  },
  {
   "i": 12,
   "text": "\u092a\u0930 \u092f\u0947 \u0915\u093e\u092e \u0905\u0915\u0947\u0932\u0947 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e, \u0905\u0938\u0941\u0930\u094b\u0902 \u0915\u094b \u092d\u0940 \u0938\u093e\u0925 \u0932\u094b\u0964",
   "start": 40.128,
   "end": 43.473
  },
  {
   "i": 13,
   "text": "\u0924\u094b \u092e\u0902\u0926\u0930\u093e\u091a\u0932 \u092a\u0930\u094d\u0935\u0924 \u092c\u0928\u093e \u092e\u0925\u093e\u0928\u0940,",
   "start": 43.723,
   "end": 45.763
  },
  {
   "i": 14,
   "text": "\u0914\u0930 \u0928\u093e\u0917\u0930\u093e\u091c \u0935\u093e\u0938\u0941\u0915\u093f \u092c\u0928\u0947 \u0930\u0938\u094d\u0938\u0940\u0964",
   "start": 46.103,
   "end": 48.012
  },
  {
   "i": 15,
   "text": "\u090f\u0915 \u0924\u0930\u092b\u093c \u0926\u0947\u0935\u0924\u093e, \u0926\u0942\u0938\u0930\u0940 \u0924\u0930\u092b\u093c \u0905\u0938\u0941\u0930,",
   "start": 48.262,
   "end": 50.602
  },
  {
   "i": 16,
   "text": "\u0914\u0930 \u0936\u0941\u0930\u0942 \u0939\u0941\u0906 \u0938\u092e\u0941\u0926\u094d\u0930 \u092e\u0902\u0925\u0928\u0964",
   "start": 50.852,
   "end": 52.451
  },
  {
   "i": 17,
   "text": "\u092a\u0930 \u092d\u093e\u0930\u0940 \u092a\u0930\u094d\u0935\u0924, \u0938\u092e\u0941\u0926\u094d\u0930 \u092e\u0947\u0902 \u0921\u0942\u092c\u0928\u0947 \u0932\u0917\u093e\u0964",
   "start": 52.701,
   "end": 55.338
  },
  {
   "i": 18,
   "text": "\u0924\u092c \u0935\u093f\u0937\u094d\u0923\u0941 \u091c\u0940 \u0928\u0947 \u0915\u091b\u0941\u090f \u0915\u093e \u0930\u0942\u092a \u0932\u093f\u092f\u093e, \u0915\u0942\u0930\u094d\u092e \u0905\u0935\u0924\u093e\u0930,",
   "start": 55.588,
   "end": 58.768
  },
  {
   "i": 19,
   "text": "\u0914\u0930 \u092a\u0942\u0930\u0947 \u092a\u0930\u094d\u0935\u0924 \u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0940\u0920 \u092a\u0930 \u0909\u0920\u093e \u0932\u093f\u092f\u093e\u0964",
   "start": 59.068,
   "end": 61.619
  },
  {
   "i": 20,
   "text": "\u092e\u0902\u0925\u0928 \u0938\u0947 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0928\u093f\u0915\u0932\u093e \u0939\u0932\u093e\u0939\u0932,",
   "start": 61.869,
   "end": 64.09
  },
  {
   "i": 21,
   "text": "\u0910\u0938\u093e \u092d\u092f\u093e\u0928\u0915 \u0935\u093f\u0937, \u091c\u094b \u092a\u0942\u0930\u0940 \u0938\u0943\u0937\u094d\u091f\u093f \u0915\u094b \u091c\u0932\u093e \u0938\u0915\u0924\u093e \u0925\u093e\u0964",
   "start": 64.419,
   "end": 67.863
  },
  {
   "i": 22,
   "text": "\u0938\u092c \u0921\u0930 \u0917\u090f\u0964 \u0924\u092c \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0906\u0917\u0947 \u0906\u090f,",
   "start": 68.113,
   "end": 70.683
  },
  {
   "i": 23,
   "text": "\u0914\u0930 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0938\u093e\u0930\u093e \u0935\u093f\u0937 \u092a\u0940 \u0932\u093f\u092f\u093e\u0964",
   "start": 71.043,
   "end": 72.666
  },
  {
   "i": 24,
   "text": "\u092e\u093e\u0924\u093e \u092a\u093e\u0930\u094d\u0935\u0924\u0940 \u0928\u0947 \u0909\u0928\u0915\u093e \u0915\u0902\u0920 \u0925\u093e\u092e \u0932\u093f\u092f\u093e,",
   "start": 72.916,
   "end": 75.496
  },
  {
   "i": 25,
   "text": "\u0935\u093f\u0937 \u0917\u0932\u0947 \u092e\u0947\u0902 \u0939\u0940 \u0930\u0941\u0915 \u0917\u092f\u093e, \u0914\u0930 \u0915\u0902\u0920 \u0928\u0940\u0932\u093e \u0939\u094b \u0917\u092f\u093e\u0964",
   "start": 75.836,
   "end": 78.741
  },
  {
   "i": 26,
   "text": "\u0907\u0938\u0940\u0932\u093f\u090f \u0936\u093f\u0935 \u091c\u0940 \u0915\u0939\u0932\u093e\u090f, \u0928\u0940\u0932\u0915\u0902\u0920\u0964",
   "start": 78.991,
   "end": 81.172
  },
  {
   "i": 27,
   "text": "\u092b\u093f\u0930 \u0928\u093f\u0915\u0932\u0947 \u0905\u0928\u092e\u094b\u0932 \u0930\u0924\u094d\u0928, \u0915\u093e\u092e\u0927\u0947\u0928\u0941 \u0917\u093e\u092f, \u0909\u091a\u094d\u091a\u0948\u0936\u094d\u0930\u0935\u093e \u0918\u094b\u0921\u093c\u093e, \u0915\u0932\u094d\u092a\u0935\u0943\u0915\u094d\u0937,",
   "start": 81.422,
   "end": 85.992
  },
  {
   "i": 28,
   "text": "\u0914\u0930 \u0915\u092e\u0932 \u092a\u0930 \u0935\u093f\u0930\u093e\u091c\u092e\u093e\u0928 \u092e\u093e\u0924\u093e \u0932\u0915\u094d\u0937\u094d\u092e\u0940,",
   "start": 86.132,
   "end": 88.312
  },
  {
   "i": 29,
   "text": "\u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u092d\u0917\u0935\u093e\u0928 \u0935\u093f\u0937\u094d\u0923\u0941 \u0915\u094b \u091a\u0941\u0928\u093e\u0964",
   "start": 88.662,
   "end": 90.395
  },
  {
   "i": 30,
   "text": "\u0906\u0916\u093c\u093f\u0930 \u092e\u0947\u0902 \u0927\u0928\u094d\u0935\u0902\u0924\u0930\u093f \u092a\u094d\u0930\u0915\u091f \u0939\u0941\u090f, \u0939\u093e\u0925 \u092e\u0947\u0902 \u0905\u092e\u0943\u0924 \u0915\u0932\u0936 \u0932\u093f\u090f\u0964",
   "start": 90.645,
   "end": 94.428
  },
  {
   "i": 31,
   "text": "\u092a\u0930 \u0905\u0938\u0941\u0930\u094b\u0902 \u0928\u0947 \u0915\u0932\u0936 \u091b\u0940\u0928 \u0932\u093f\u092f\u093e!",
   "start": 94.678,
   "end": 96.65
  },
  {
   "i": 32,
   "text": "\u0924\u092c \u0935\u093f\u0937\u094d\u0923\u0941 \u091c\u0940 \u0928\u0947 \u0932\u093f\u092f\u093e \u092e\u094b\u0939\u093f\u0928\u0940 \u0930\u0942\u092a,",
   "start": 96.9,
   "end": 99.03
  },
  {
   "i": 33,
   "text": "\u0914\u0930 \u091a\u0924\u0941\u0930\u093e\u0908 \u0938\u0947 \u0938\u093e\u0930\u093e \u0905\u092e\u0943\u0924 \u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0915\u094b \u092a\u093f\u0932\u093e \u0926\u093f\u092f\u093e\u0964",
   "start": 99.4,
   "end": 102.603
  },
  {
   "i": 34,
   "text": "\u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0915\u093e \u0916\u094b\u092f\u093e \u0924\u0947\u091c \u0932\u094c\u091f \u0906\u092f\u093e\u0964",
   "start": 102.853,
   "end": 104.909
  },
  {
   "i": 35,
   "text": "\u092f\u093e\u0926 \u0930\u0916\u093f\u090f, \u0905\u092e\u0943\u0924 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0935\u093f\u0937 \u0906\u0924\u093e \u0939\u0948\u0964",
   "start": 105.159,
   "end": 107.67
  },
  {
   "i": 36,
   "text": "\u091c\u094b \u0927\u0948\u0930\u094d\u092f \u0938\u0947 \u0935\u093f\u0937 \u0938\u0939 \u0932\u0947, \u0905\u092e\u0943\u0924 \u0909\u0938\u0940 \u0915\u094b \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964",
   "start": 107.92,
   "end": 111.198
  }
 ]
}